# Example for local (Mac) runs. Copy to .env and fill in the placeholders:
#   cp .env.example .env
# Values may be quoted here (python-dotenv strips quotes).

# CREDENTIALS
# HuggingFace
HF_TOKEN=hf_your_token_here
HF_XET_HIGH_PERFORMANCE=1
# Google Cloud Storage
USE_CLOUD_STORAGE=False
GCS_BUCKET_NAME="your-gcs-bucket-name"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/gcs-key.json"

SPEECH_DATASET="openslr/librispeech_asr"
IR_DATASET="benjamin-paine/mit-impulse-response-survey"

SEED=123
PYTHONUNBUFFERED=1

RUN_NOISE_TESTS=False
LAUNCH_GRADIO=False

# Not really used at the moment - Benchmark run both small and large (True, False)
#MODEL_SMALL=True

# Either mlx or hf (huggingface Transformers)
INFERENCE_BACKEND="mlx"
REQUIRE_CUDA=False
#MLX_SMALL_MODEL_NAME="mlx-community/whisper-small-mlx"
#MLX_LARGE_MODEL_NAME="mlx-community/whisper-large-v3-turbo"
#HF_TRANSFORMER_SMALL_MODEL_NAME="openai/whisper-small"
#HF_TRANSFORMER_LARGE_MODEL_NAME="openai/whisper-large-v3-turbo"
MLX_MODELS=mlx-community/whisper-small-mlx,mlx-community/whisper-large-v3-turbo
HF_MODELS=openai/whisper-small,openai/whisper-large-v3-turbo

# == Benchmark Flags ==
# inference runs will verify first if a previous run has been cached as pickle file in TRANSCRIBE_CACHE_DIR
# and load it first if available. Otherwise will run inference.
# Force train runs inference if previous run is present and overwrites the file.
# runs are labeled as such: <type>__<modelname>__<numberOfSamples>__<postfixInfo>.pkl
# if any of those variables do not match, the inference run is considered different and will run.
FORCE_RETRAIN=False
RUN_BENCHMARK_INFERENCE=True

# For future implementation. Not used at the moment.
IS_MOCK=True

# == Speed Comparison Flags ==
RUN_FRAMEWORK_SPEED_COMPARISON_TEST=False

# To run frameworkd comparison between 'mlx' and 'mps', need to force it.
# Otherwise, will run on 'cpu'
FORCE_MPS=True

# Test types:
#   These are used for labeling the runs results file and to determine the list of corruptions to use
#
#   1- smallDr      (small dress rehearsal - 3 corruption types)
#   2- fullDr       (full dress rehearsal - full list of corruptions)
#   3- fullRun      (full run - full list of corruptions)
TEST_TYPE='smallDr'

NUMBER_OF_SAMPLES=9
# Application checkpoints size
CHECKPOINT_SIZE=5

# Number of multiprocessing workers for CPU bound blocks
N_PREP_WORKERS=1

#GPU Batch size
BATCH_SIZE=1

SAMPLES_PER_CALL=2